{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "RealtyCrawl",
  "description": "Source-linked real estate observations through REST, MCP, and agent skills.",
  "colors": {
    "primary": "#447B39",
    "light": "#8AB54C",
    "dark": "#336B36"
  },
  "logo": {
    "light": "/wordmark-light.svg",
    "dark": "/wordmark-dark.svg",
    "href": "https://realtycrawl.dev"
  },
  "favicon": "/logo.svg",
  "fonts": {
    "family": "Inter"
  },
  "background": {
    "color": {
      "light": "#FCFDF8",
      "dark": "#102D1C"
    }
  },
  "api": {
    "openapi": "openapi.json",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript"
      ],
      "defaults": "required",
      "prefill": true,
      "autogenerate": true
    }
  },
  "navigation": {
    "tabs": [
